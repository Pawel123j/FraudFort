# Copy to .env and adjust as needed. .env is gitignored.

# === PostgreSQL ===
POSTGRES_DB=fraudfort
POSTGRES_USER=fraudfort
POSTGRES_PASSWORD=fraudfort_dev
POSTGRES_PORT=5432

# === Redis ===
REDIS_PORT=6379

# === Orchestrator (Spring Boot) ===
ORCHESTRATOR_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# === Scoring service (FastAPI) — Etap 2 ===
SCORING_PORT=8000

# === Kafka — Etap 4 ===
KAFKA_PORT=9092
