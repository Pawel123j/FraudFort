# Copy to .env and adjust as needed. .env is gitignored.

# === PostgreSQL ===
POSTGRES_DB=fraudfort
POSTGRES_USER=fraudfort
# Wymagane. Generowanie: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# === Redis ===
REDIS_PASSWORD=
REDIS_PORT=6379

# === Orchestrator (Spring Boot) ===
ORCHESTRATOR_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# OAuth2 resource server (FF-01) — wymagane; orchestrator nie wystartuje bez wystawcy.
# Przykład (Keycloak): https://auth.example.com/realms/fraudfort
FRAUDFORT_JWT_ISSUER_URI=
# Opcjonalnie, gdy discovery wystawcy jest niedostępne:
FRAUDFORT_JWT_JWK_SET_URI=
# Wartość claimu "aud", którą muszą mieć tokeny dla tego API.
FRAUDFORT_JWT_AUDIENCE=fraudfort-api
# Scope: transactions:write, transactions:read, transactions:analyst, metrics:read
FRAUDFORT_LOG_LEVEL=INFO

# === Scoring service (FastAPI) — Etap 2 ===
SCORING_PORT=8000

# === Kafka — Etap 4 ===
KAFKA_PORT=9092
